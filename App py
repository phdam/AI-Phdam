import os
import json
from pathlib import Path
from urllib.parse import quote

import httpx
from fastapi import FastAPI, HTTPException
from fastapi.responses import FileResponse, Response
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from google import genai

app = FastAPI(title="AI Phdam Music")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

BASE_DIR = Path(__file__).resolve().parent

GEMINI_API_KEY = os.getenv("GEMINI_API_KEY", "")
GEMINI_MODEL = os.getenv("GEMINI_MODEL", "gemini-2.5-flash")

ACE_STEP_URL = os.getenv("ACE_STEP_URL", "").rstrip("/")
ACE_STEP_API_KEY = os.getenv("ACE_STEP_API_KEY", "")


class LyricsRequest(BaseModel):
    idea: str = Field(min_length=3, max_length=4000)
    genre: str = "Modern Bolero Remix"
    voice: str = "Nam cao"
    mood: str = "Hài hòa, hiện đại"
    language: str = "Tiếng Việt"


class MusicRequest(BaseModel):
    lyrics: str = Field(min_length=1, max_length=12000)
    genre: str = "Modern Bolero Remix"
    instruments: str = "Guitar, piano, bass, electronic drums"
    voice: str = "Nam cao"
    bpm: int = Field(default=90, ge=30, le=300)
    duration: int = Field(default=120, ge=10, le=600)
    format: str = "mp3"


def ace_headers():
    headers = {"Content-Type": "application/json"}
    if ACE_STEP_API_KEY:
        headers["Authorization"] = f"Bearer {ACE_STEP_API_KEY}"
    return headers


@app.get("/")
def home():
    index_file = BASE_DIR / "index.html"
    if not index_file.exists():
        raise HTTPException(404, "Không tìm thấy index.html")
    return FileResponse(index_file)


@app.get("/api/health")
def health():
    return {
        "app": "AI Phdam Music",
        "server": "online",
        "gemini_configured": bool(GEMINI_API_KEY),
        "music_server_configured": bool(ACE_STEP_URL),
        "music_generation_ready": bool(ACE_STEP_URL),
    }


@app.post("/api/lyrics")
def create_lyrics(req: LyricsRequest):
    if not GEMINI_API_KEY:
        raise HTTPException(503, "Chưa cấu hình GEMINI_API_KEY.")

    try:
        client = genai.Client(api_key=GEMINI_API_KEY)

        prompt = f"""
Bạn là nhạc sĩ chuyên sáng tác nhạc Việt Nam hiện đại.

Ý tưởng: {req.idea}
Thể loại: {req.genre}
Giọng hát: {req.voice}
Cảm xúc: {req.mood}
Ngôn ngữ: {req.language}

Hãy sáng tác một bài hát hoàn chỉnh.
Yêu cầu:
- Lời tự nhiên, gần gũi, dễ hát.
- Không dùng từ ngữ quá cầu kỳ.
- Có cấu trúc Intro, Verse, Chorus, Bridge, Outro khi phù hợp.
- Điệp khúc có câu nhấn dễ nhớ.
- Không tự ý thêm hát bè.
- Không sao chép lời bài hát có bản quyền.
- Chỉ trả về tên và lời bài hát.
"""

        result = client.models.generate_content(
            model=GEMINI_MODEL,
            contents=prompt
        )

        return {"success": True, "lyrics": result.text}

    except Exception as exc:
        raise HTTPException(502, f"Lỗi Gemini: {str(exc)}")


@app.post("/api/music/generate")
async def generate_music(req: MusicRequest):
    if not ACE_STEP_URL:
        raise HTTPException(
            503,
            "Chưa cấu hình máy chủ ACE-Step. Chưa thể tạo nhạc."
        )

    prompt = (
        f"{req.genre}, {req.instruments}, "
        f"{req.voice} vocal, modern professional production, "
        "clear Vietnamese singing, balanced mixing"
    )

    payload = {
        "prompt": prompt,
        "lyrics": req.lyrics,
        "thinking": True,
        "vocal_language": "vi",
        "audio_format": req.format,
        "audio_duration": req.duration,
        "bpm": req.bpm,
        "inference_steps": 8,
        "use_format": True,
        "batch_size": 1,
    }

    try:
        async with httpx.AsyncClient(timeout=90) as client:
            response = await client.post(
                f"{ACE_STEP_URL}/release_task",
                json=payload,
                headers=ace_headers()
            )
            response.raise_for_status()
            data = response.json()

        if data.get("error"):
            raise HTTPException(502, str(data["error"]))

        task = data.get("data", {})
        task_id = task.get("task_id")

        if not task_id:
            raise HTTPException(
                502,
                "ACE-Step không trả về mã tác vụ."
            )

        return {
            "success": True,
            "task_id": task_id,
            "message": "Đã gửi yêu cầu tạo nhạc."
        }

    except httpx.HTTPError as exc:
        raise HTTPException(
            502,
            f"Lỗi kết nối ACE-Step: {str(exc)}"
        )


@app.get("/api/music/status/{task_id}")
async def music_status(task_id: str):
    if not ACE_STEP_URL:
        raise HTTPException(503, "Chưa cấu hình ACE-Step.")

    try:
        async with httpx.AsyncClient(timeout=40) as client:
            response = await client.post(
                f"{ACE_STEP_URL}/query_result",
                json={"task_id_list": [task_id]},
                headers=ace_headers()
            )
            response.raise_for_status()
            data = response.json()

        if data.get("error"):
            raise HTTPException(502, str(data["error"]))

        results = data.get("data", [])

        if not results:
            raise HTTPException(404, "Chưa tìm thấy tác vụ.")

        task = results[0]
        status = task.get("status", 0)
        result_data = task.get("result", [])

        if isinstance(result_data, str):
            try:
                result_data = json.loads(result_data)
            except json.JSONDecodeError:
                result_data = []

        audio_files = []

        if status == 1:
            for item in result_data:
                file_path = item.get("file")
                if file_path:
                    audio_files.append(
                        "/api/audio?path=" + quote(file_path, safe="")
                    )

        return {
            "success": True,
            "task_id": task_id,
            "status": status,
            "audio_files": audio_files,
            "error": task.get("error")
        }

    except httpx.HTTPError as exc:
        raise HTTPException(502, f"Lỗi kiểm tra tác vụ: {str(exc)}")


@app.get("/api/audio")
async def get_audio(path: str):
    if not ACE_STEP_URL:
        raise HTTPException(503, "Chưa cấu hình ACE-Step.")

    if not path.startswith("/v1/audio?path="):
        raise HTTPException(400, "Đường dẫn âm thanh không hợp lệ.")

    try:
        async with httpx.AsyncClient(timeout=120) as client:
            response = await client.get(
                ACE_STEP_URL + path,
                headers=ace_headers()
            )
            response.raise_for_status()

        return Response(
            content=response.content,
            media_type=response.headers.get(
                "content-type", "audio/mpeg"
            ),
            headers={"Cache-Control": "no-store"}
        )

    except httpx.HTTPError as exc:
        raise HTTPException(502, f"Lỗi tải âm thanh: {str(exc)}")
